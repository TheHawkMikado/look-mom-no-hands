{
  "manifest_version": 3,
  "name": "No Hands Browser Runner",
  "version": "0.1.0",
  "description": "Lets Look Ma, No Hands read the page you're on and act on it precisely: a ref-based snapshot of the live DOM instead of screen-label guessing.",
  "permissions": ["tabs", "scripting", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle", "all_frames": false }
  ],
  "action": { "default_popup": "popup/popup.html", "default_title": "No Hands Browser Runner" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
