<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Not sandboxed: posting CGEvents and reading other apps' Accessibility
         trees to control the screen is impossible inside the App Sandbox. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    <!-- Hardened runtime blocks the microphone unless this is present — without
         it the app never prompts and never appears in the Microphone list. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- Calendars behave exactly like the microphone under hardened runtime:
         without this, requestFullAccessToEvents returns "declined" instantly,
         no dialog ever appears, and the app never shows up in System Settings →
         Privacy → Calendars. The Info.plist usage string alone is not enough.
         Any future protected resource (Reminders, Contacts, Photos) needs its
         own com.apple.security.personal-information.* key here too. -->
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
</dict>
</plist>
